<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Taskboard</AssemblyName>
    <Version>0.9.53</Version>
    <DraftSwitchSpeed Condition="'$(DraftSwitchSpeed)' == ''">1.35</DraftSwitchSpeed>
    <DefineConstants Condition="'$(DraftSwitchSpeed)' == '1.35'">$(DefineConstants);FAST_DRAFT_SWITCH</DefineConstants>
    <Product>摸鱼台 · MoyuDesk</Product>
    <AssemblyTitle>摸鱼台 · MoyuDesk</AssemblyTitle>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets/orb.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="integrations/dsh-observer.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/orb.ico" />
    <Resource Include="Assets/HelpScreenshots/*.png" />
    <EmbeddedResource Include="Assets/Alarm04.wav" LogicalName="Taskboard.DefaultNotification.wav" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <InternalsVisibleTo Include="Taskboard.Binding.Tests" />
    <ProjectReference Include="../Taskboard.Core/Taskboard.Core.csproj" />
  </ItemGroup>
  <Import Project="Modules/*.props" />
</Project>
